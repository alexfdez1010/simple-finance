  "narrative": {
    "northStar": "The Investor Research Notebook",
    "overview": "The interface organizes a private portfolio with calm surfaces, comparable figures, and persistent wayfinding. Mist ground and white containers keep dense financial information legible; forest identifies actions and selection while graphite carries the reading hierarchy.\n\nThe user confirmed a personal tool and its four workspaces, then requested code-led implementation and review. The notebook metaphor was inferred during that redesign rather than selected through a visual workshop. The notebook means disciplined alignment and focused workspaces, without stationery textures. These rules describe the implemented system; individual page compositions remain in the surface brief.",
    "keyCharacteristics": [
      "Opaque surfaces and quiet borders.",
      "One sans family for the main hierarchy and tabular financial figures.",
      "Focused routes with persistent desktop navigation and an unobscured mobile strip.",
      "Explicit data states and a separate visual language for gains and losses."
    ],
    "rules": [
      {
        "name": "The Meaningful Color Rule",
        "body": "Reserve gain and loss for financial meaning; chart series and selected navigation have their own roles.",
        "section": "colors"
      },
      {
        "name": "The Comparable Figures Rule",
        "body": "Financial values use tabular numerals. Summary values share one baseline and use a compact responsive size rather than oversized display typography.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Use tonal separation and borders for workspace containers; reserve elevation for floating content.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use opaque white surfaces, quiet borders, and the shared corner scale.",
      "**Do** preserve tabular figures, explicit units, and meaningful gain/loss signs.",
      "**Do** keep navigation visible and allow controls and long values to wrap on small screens.",
      "**Do** retain visible keyboard focus and respect reduced-motion preferences."
    ],
    "donts": [
      "**Don't** substitute decorative transparency or ambient card shadows for the established flat surfaces.",
      "**Don't** use color alone to explain a financial state.",
      "**Don't** promote page-specific chart arrangements into a universal layout requirement."
    ]
  }
}
