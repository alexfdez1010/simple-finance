      "css": ".ds-nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;padding:8px;border:1px solid rgb(255 255 255/.7);border-radius:16px;background:var(--surface,#fff);box-shadow:0 8px 40px rgb(25 36 60/.12);}.ds-nav-link{display:flex;align-items:center;justify-content:center;min-height:48px;padding:8px 4px;border-radius:12px;color:var(--muted,#666b76);font-family:var(--font-geist-sans,Geist),sans-serif;font-size:10px;font-weight:500;text-decoration:none;transition:background-color 180ms ease,color 180ms ease,transform 250ms cubic-bezier(.16,1,.3,1);}.ds-nav-link[aria-current=\"page\"]{background:color-mix(in srgb,var(--accent,#0066e5) 8%,transparent);color:var(--accent,#0066e5);}.ds-nav-link:hover{background:var(--default,#edeef2);color:var(--foreground,#1d1d1f);}.ds-nav-link:focus-visible{outline:2px solid var(--focus,#0066e5);outline-offset:3px;}.ds-nav-link:active{transform:scale(.97);}@media(min-width:1024px){.ds-nav{grid-template-columns:1fr;gap:6px;padding:0;border:0;border-radius:0;box-shadow:none;}.ds-nav-link{justify-content:flex-start;padding:8px 16px;font-size:13px;}}@media(prefers-reduced-motion:reduce){.ds-nav-link{transition:none;}}"
    },
    {
      "name": "Metadata Chip",
      "kind": "chip",
      "refersTo": "metadata-chip",
      "description": "Existing compact monospace metadata badge.",
      "html": "<span class=\"ds-chip\">CUSTOM</span>",
      "css": ".ds-chip{display:inline-flex;width:fit-content;padding:0 4px;border-radius:16px;background:var(--default,#edeef2);color:var(--foreground,#1d1d1f);font-family:var(--font-geist-mono,\"Geist Mono\"),monospace;font-size:10px;font-weight:500;line-height:20px;letter-spacing:.025em;}"
    },
    {
      "name": "Financial Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Softly elevated opaque container with responsive insets and no default border.",
      "html": "<section class=\"ds-card\"><header class=\"ds-card-header\"><h2 class=\"ds-card-title\">Portfolio Evolution</h2><p class=\"ds-card-description\">Latest snapshots, including cash flows</p></header><div class=\"ds-card-body\">No data yet, data appears after the first daily snapshot</div></section>",
      "css": ".ds-card{min-width:0;border:0;border-radius:16px;background:var(--surface,#fff);color:var(--foreground,#1d1d1f);font-family:var(--font-geist-sans,Geist),sans-serif;box-shadow:var(--surface-shadow,0 4px 24px rgb(25 36 60/.035));}.ds-card-header{padding:20px 20px 12px;}.ds-card-title{margin:0;font-size:15px;font-weight:600;letter-spacing:-.02em;}.ds-card-description{margin:6px 0 0;font-size:12px;line-height:16px;color:var(--muted,#666b76);}.ds-card-body{padding:0 20px 20px;font-size:14px;}@media(min-width:640px){.ds-card-header{padding:24px 24px 12px;}.ds-card-body{padding:0 24px 24px;}}"
    },
    {
      "name": "Balance Panel",
      "kind": "custom",
      "refersTo": "balance-panel",
      "description": "Signature dark valuation surface; this preview uses an unavailable value rather than a fabricated balance.",
      "html": "<section class=\"ds-balance\" aria-label=\"Total Value\"><p class=\"ds-balance-label\">Total Value</p><p class=\"ds-balance-value\">\u2014</p><p class=\"ds-balance-detail\">Current portfolio valuation</p></section>",
      "css": ".ds-balance{position:relative;isolation:isolate;overflow:hidden;min-width:0;padding:24px;border-radius:16px;background:#20242d;color:#fff;font-family:var(--font-geist-sans,Geist),sans-serif;}.ds-balance::before{content:\"\";position:absolute;inset:0;z-index:-1;background:radial-gradient(ellipse at 100% 0%,#354664 0%,transparent 65%);}.ds-balance-label{margin:0;font-size:14px;font-weight:500;color:rgb(255 255 255/.75);}.ds-balance-value{margin:32px 0;font-size:clamp(2rem,3.5vw,3.25rem);line-height:1.25;font-weight:500;letter-spacing:-.035em;font-variant-numeric:tabular-nums;overflow-wrap:anywhere;}.ds-balance-detail{margin:0;font-size:12px;color:rgb(255 255 255/.65);}@media(min-width:640px){.ds-balance{padding:32px;}}"
    }
  ],
  "narrative": {
    "northStar": "Precision, in perspective",
    "overview": "The interface gives a personal portfolio a clear center of gravity. Aluminum ground, white surfaces, graphite type, and precise blue controls frame the information; the dark balance panel makes the present valuation immediately recognizable. Generous spacing and a deliberate type hierarchy give financial detail room to be read.\n\nThe user authorized a complete visual and interaction redesign using the agent's judgment, with polished motion and review of the running application. This direction replaces the earlier forest notebook system. Existing financial meanings, English copy, portfolio capabilities, and independently loaded workspaces remain product constraints. The implementation uses CSS and the existing component adapters without adding dependencies or decorative raster assets.",
    "keyCharacteristics": [
      "A prominent balance, then comparable supporting figures and detailed evidence.",
      "Softly elevated white surfaces on an aluminum ground.",
      "Geist typography, tabular financial figures, and explicit units.",
      "Persistent desktop wayfinding and a safe-area-aware mobile dock.",
      "Short, bounded motion with complete reduced-motion behavior."
    ],
    "rules": [
      {
        "name": "The Meaningful Color Rule",
        "body": "Keep interaction, series identity, and financial outcome separate; never use color as the only explanation of a value.",
        "section": "colors"
      },
      {
        "name": "The Clear Titles Rule",
        "body": "Titles and subtitles have no final full stops or decorative dot separators, and brand compositions have no decorative dots. Keep functional chart/category markers and original user-supplied instrument names and symbols intact.",
        "section": "typography"
      },
      {
        "name": "The Comparable Figures Rule",
        "body": "Use tabular numerals, explicit currency units, and stable alignment. Large values may wrap; mobile preview amounts may use compact notation.",
        "section": "typography"
      },
      {
        "name": "The Earned Depth Rule",
        "body": "Apply depth to communicate a container or interaction level, with stronger elevation reserved for floating navigation and overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use the shared aluminum, white, graphite, and blue hierarchy.",
      "**Do** preserve real financial values, explicit units, signs, and unavailable-data states.",
      "**Do** keep route navigation visible and reserve space for the mobile dock.",
      "**Do** keep titles and subtitles free of final full stops and decorative dot separators, and omit decorative dots from brands.",
      "**Do** retain visible focus, focus restoration, and reduced-motion and reduced-transparency behavior.",
      "**Do** keep animations short, bounded, and independent of chart mark rendering."
    ],
    "donts": [
      "**Don't** add fabricated portfolio values or illustrative chart histories to production.",
      "**Don't** use color alone to communicate financial outcomes or chart categories.",
      "**Don't** apply dock translucency to ordinary financial cards.",
      "**Don't** let motion delay interaction or conceal chart marks after hydration.",
      "**Don't** promote the home chart arrangement into a rule for every workspace."
    ]
  }
}
