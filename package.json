{
  "name": "simple-finance",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate --schema prisma && next build",
    "start": "wrangler dev --port 3000 --infer-origin-from-routes=false",
    "lint": "eslint . --fix && bun run database:format",
    "launch": "bun run database && bun run dev",
    "format": "bunx prettier . --write",
    "lint-format": "bun run lint && bun run format",
    "pre-commit": "bun run lint-format && bun run test",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run --dir tests/unit",
    "test:e2e": "bun run test:worker",
    "test:specific": "bunx playwright test -g",
    "database:deploy": "wrangler d1 migrations apply DB --remote",
    "database": "wrangler d1 migrations apply DB --local",
    "database:test": "bun run database",
    "database:create": "prisma generate --schema prisma && bun run database",
    "database:format": "prisma format --schema prisma",
    "playwright": "bunx playwright test --ui",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview": "bun run build:cloudflare && bun run start",
    "deploy": "bun run build:cloudflare && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --include-runtime false --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:worker": "bun run build:cloudflare && start-server-and-test \"wrangler dev --port 3000 --test-scheduled --infer-origin-from-routes=false\" http://localhost:3000 \"playwright test\""
  },
  "dependencies": {
    "@better-auth/mcp": "1.7.15",
    "@better-auth/oauth-provider": "1.7.15",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opennextjs/cloudflare": "^1.20.15",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-d1": "6.19.3",
    "@prisma/client": "^6.19.3",
    "better-auth": "1.7.15",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "mcp-handler": "^1.1.0",
    "next": "16.2.12",
    "node-fetch": "^2.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.6.0",
    "yahoo-finance2": "^3.14.0",
    "zod": "^4.6.7"
  },
  "overrides": {},
  "resolutions": {},
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^20.19.40",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "better-sqlite3": "11.10.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^24.1.3",
    "prisma": "^6.19.3",
    "start-server-and-test": "^2.1.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.156.0"
  }
}
