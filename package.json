{
  "name": "simple-finance",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.12",
  "scripts": {
    "dev": "bun run database && next dev --turbopack && bun run database:down",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --fix && bun run database:format",
    "launch": "bun run database && bun run build && bun run start",
    "launch:test": "bun run database:test && bun run build && bun run start && bun run database:down",
    "format": "bunx prettier . --write",
    "lint-format": "bun run lint && bun run format",
    "pre-commit": "bun run lint-format && bun run test",
    "test": "bun run test:unit && bun run test:e2e",
    "test:unit": "vitest run --dir tests/unit",
    "test:e2e": "bun run database:test && bun run build && start-server-and-test 'bun run start' http://localhost:3000 'bunx playwright test' && bun run database:down",
    "test:specific": "bunx playwright test -g",
    "database:dev": "bun run database && prisma migrate dev && bun run database:down",
    "database:deploy": "prisma migrate deploy",
    "database:check": "prisma migrate diff --to-schema-datamodel prisma/ --from-schema-datasource prisma/ --exit-code",
    "database": "docker compose up -d",
    "database:test": "docker compose -f compose-test.yml up -d && bun run database:create",
    "database:down": "docker compose down",
    "database:create": "prisma generate && prisma db push",
    "database:studio": "bun run database && bunx prisma studio && bun run database:down",
    "database:format": "prisma format",
    "playwright": "bunx playwright test --ui"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/client": "^6.19.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "mcp-handler": "^1.1.0",
    "next": "^16.2.6",
    "node-fetch": "^2.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.6.0",
    "yahoo-finance2": "^3.14.0",
    "zod": "^4.4.3"
  },
  "overrides": {
    "zod": "4.4.3"
  },
  "resolutions": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.13",
    "@types/node": "^20.19.40",
    "@types/node-fetch": "^2.6.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^24.1.3",
    "prisma": "^6.19.3",
    "start-server-and-test": "^2.1.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
